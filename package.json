{
  "name": "cfmoto-uruguay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,css,json}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,json}\" \"*.{json,mjs}\"",
    "validate": "npm run check && npm run format:check && npm run build"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  }
}
