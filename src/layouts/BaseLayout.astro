---
import { Font } from "astro:assets";

import CompareBar from "@/components/compare/CompareBar.astro";
import SEO from "@/components/seo/SEO.astro";
import { siteConfig } from "@/config/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  robots?: string;
  image?: string;
  type?: "website" | "article";
}

const props = Astro.props;
const compareBarExcludedPaths = [
  "/comparar",
  "/concesionarios",
  "/service",
  "/ubicaciones",
  "/cotizar",
  "/test-ride",
];
const showCompareBar = !compareBarExcludedPaths.some((path) =>
  Astro.url.pathname.startsWith(path),
);
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-display-loaded" />
    <Font cssVariable="--font-ui-loaded" preload />
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Saltar al contenido
    </a>
    <slot name="header" />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showCompareBar && <CompareBar />}
    <slot name="footer" />
  </body>
</html>
