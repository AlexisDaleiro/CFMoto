---
import { getCollection } from "astro:content";

import LeadForm from "@/components/lead/LeadForm.astro";
import SiteHeader from "@/components/navigation/SiteHeader.astro";
import Container from "@/components/primitives/Container.astro";
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const products = await getCollection("products");
---

<BaseLayout
  title="Cotizar — CFMOTO Uruguay"
  description="Demostración frontend de solicitud de cotización CFMOTO Uruguay."
  robots="noindex, nofollow"
>
  <SiteHeader slot="header" />
  <Section density="functional" surface="light" aria-labelledby="quote-title">
    <Container size="readable">
      <Stack gap="8">
        <div class="form-heading">
          <p class="type-label">SOLICITUD COMERCIAL</p>
          <h1 id="quote-title" class="type-display-l">
            Cotizar
          </h1>
          <p class="type-body-l">
            Elegí un modelo y completá el mínimo necesario para validar cómo
            funcionará la futura solicitud comercial.
          </p>
        </div>
        <LeadForm kind="quote" products={products} />
      </Stack>
    </Container>
  </Section>
</BaseLayout>

<style>
  .form-heading {
    display: grid;
    gap: var(--space-3);
  }
  .form-heading .type-label {
    color: var(--color-link-on-light);
  }
  .form-heading p:last-child {
    color: var(--color-text-secondary);
  }
</style>
