---
import Container from "@/components/primitives/Container.astro";
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Foundation técnico" robots="noindex, nofollow">
  <Section density="functional">
    <Container size="readable">
      <Stack gap="4">
        <p class="type-label">CFMOTO URUGUAY</p>
        <h1 class="type-heading-1">Astro Technical Foundation</h1>
        <p class="type-body-l">
          Phase 4 cargada correctamente. La Home visual se construirá en Phase
          5.
        </p>
      </Stack>
    </Container>
  </Section>
</BaseLayout>
