---
import Badge from "@/components/primitives/Badge.astro";
import Button from "@/components/primitives/Button.astro";
import Cluster from "@/components/primitives/Cluster.astro";
import Container from "@/components/primitives/Container.astro";
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import TextLink from "@/components/primitives/TextLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const colors = [
  ["Brand cyan — provisional", "var(--color-brand-cyan)"],
  ["Near black", "var(--color-neutral-950)"],
  ["Charcoal", "var(--color-neutral-900)"],
  ["Off-white", "var(--color-neutral-050)"],
  ["Success", "var(--color-success)"],
  ["Warning", "var(--color-warning)"],
  ["Error", "var(--color-error)"],
  ["Information", "var(--color-info)"],
] as const;

const spaces = ["1", "2", "3", "4", "6", "8", "12", "16"] as const;
---

<BaseLayout
  title="Foundation preview"
  description="Development-only preview del Design System foundation."
  robots="noindex, nofollow"
>
  <Section density="immersive" surface="dark" aria-labelledby="preview-title">
    <Container size="product">
      <Stack gap="6">
        <p class="type-label accent">DEVELOPMENT-ONLY FOUNDATION PREVIEW</p>
        <h1 id="preview-title" class="type-display-xl">
          Expressive where emotion matters.
        </h1>
        <p class="type-body-l intro">
          Precise where decisions matter. Este test harness no es la Home ni
          contiene datos comerciales publicables.
        </p>
        <Cluster gap="3">
          <Button href="#buttons" size="large">
            Ver primitives
          </Button>
          <Button href="/" variant="ghost" size="large">
            Volver al placeholder
          </Button>
        </Cluster>
      </Stack>
    </Container>
  </Section>

  <Section density="functional" aria-labelledby="colors-title">
    <Container size="standard">
      <Stack gap="8">
        <div class="stack stack--2">
          <p class="type-label accent-dark">FOUNDATIONS</p>
          <h2 id="colors-title" class="type-heading-2">
            Colors
          </h2>
        </div>
        <div class="swatches">
          {colors.map(([label, value]) => (
            <div class="swatch">
              <span
                class="swatch__color"
                style={`--swatch: ${value}`}
                aria-hidden="true"
              />
              <span class="type-body-s">{label}</span>
            </div>
          ))}
        </div>
      </Stack>
    </Container>
  </Section>

  <Section density="editorial" surface="light" aria-labelledby="type-title">
    <Container size="wide">
      <Stack gap="8">
        <h2 id="type-title" class="type-heading-2">
          Typography
        </h2>
        <div class="type-specimens">
          <p class="type-display-l">450SR — PLAY TO WIN</p>
          <p class="type-heading-1">Ingeniería que se siente.</p>
          <p class="type-heading-3">Claridad para comparar y decidir</p>
          <p class="type-body-l readable">
            Barlow Condensed se reserva para identidad, display y datos. Inter
            mantiene legibles el contenido, las especificaciones y la interfaz.
          </p>
          <p class="type-body-m readable">
            Texto de cuerpo para validar ritmo, caracteres en español, números y
            nombres largos como ZFORCE 1000 Sport y 700CL-X Heritage.
          </p>
          <p class="type-caption">Caption · fuente, fecha y verificación.</p>
        </div>
      </Stack>
    </Container>
  </Section>

  <Section density="functional" aria-labelledby="containers-title">
    <Container size="standard">
      <Stack gap="8">
        <h2 id="containers-title" class="type-heading-2">
          Containers & grid
        </h2>
        <div class="container-demo container-demo--readable">
          Readable · 720px
        </div>
        <div class="container-demo container-demo--standard">
          Standard · 1200px
        </div>
        <div class="container-demo container-demo--wide">Wide · 1440px</div>
        <div class="layout-grid grid-demo" aria-label="Responsive grid columns">
          {Array.from({ length: 12 }, (_, index) => (
            <span>{index + 1}</span>
          ))}
        </div>
      </Stack>
    </Container>
  </Section>

  <Section density="functional" surface="light" aria-labelledby="spacing-title">
    <Container size="standard">
      <Stack gap="8">
        <h2 id="spacing-title" class="type-heading-2">
          Spacing
        </h2>
        <div class="spacing-demo">
          {spaces.map((space) => (
            <div>
              <span class="type-label">space-{space}</span>
              <span
                class="space-bar"
                style={`--space-size: var(--space-${space})`}
              />
            </div>
          ))}
        </div>
      </Stack>
    </Container>
  </Section>

  <Section id="buttons" density="functional" aria-labelledby="buttons-title">
    <Container size="standard">
      <Stack gap="8">
        <h2 id="buttons-title" class="type-heading-2">
          Buttons, links & badges
        </h2>
        <Cluster gap="3">
          <Button>Cotizar</Button>
          <Button variant="secondary">Test Ride</Button>
          <Button variant="tertiary">Comparar</Button>
          <Button disabled>No disponible</Button>
        </Cluster>
        <Cluster gap="3">
          <TextLink href="#stats" directional>
            Explorar datos técnicos
          </TextLink>
          <Badge>Adventure</Badge>
          <Badge variant="capability">Service</Badge>
          <Badge variant="commercial">Nuevo</Badge>
          <Badge variant="status">Próximamente</Badge>
        </Cluster>
        <p class="type-body-s">
          Usá Tab para comprobar el focus ring sobre controles y superficies.
        </p>
      </Stack>
    </Container>
  </Section>

  <Section
    id="stats"
    density="editorial"
    surface="dark"
    aria-labelledby="stats-title"
  >
    <Container size="wide">
      <Stack gap="8">
        <div class="stack stack--2">
          <p class="type-label accent">
            TYPOGRAPHIC TEST DATA — NOT PRODUCT CONTENT
          </p>
          <h2 id="stats-title" class="type-heading-2">
            Key stats
          </h2>
        </div>
        <dl class="stats">
          <div>
            <dt>
              450 <span>cc</span>
            </dt>
            <dd>Cilindrada</dd>
          </div>
          <div>
            <dt>
              50 <span>HP</span>
            </dt>
            <dd>Potencia</dd>
          </div>
          <div>
            <dt>
              39 <span>Nm</span>
            </dt>
            <dd>Torque</dd>
          </div>
          <div>
            <dt>
              168 <span>kg</span>
            </dt>
            <dd>Peso</dd>
          </div>
        </dl>
        <div class="technical-rows">
          <div>
            <dt>Estado del contenido</dt>
            <dd>No verificado / solo muestra tipográfica</dd>
          </div>
          <div>
            <dt>Border system</dt>
            <dd>Hairline + spacing, sin sombras de card</dd>
          </div>
        </div>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

<style>
  .accent {
    color: var(--color-brand-cyan);
  }

  .accent-dark {
    color: var(--color-link-on-light);
  }

  .intro,
  .readable {
    max-width: 65ch;
  }

  .intro {
    color: var(--color-text-inverted-secondary);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-4);
  }

  .swatch {
    display: grid;
    gap: var(--space-2);
  }

  .swatch__color {
    min-height: 5rem;
    border: var(--border-hairline) solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--swatch);
  }

  .type-specimens {
    display: grid;
    gap: var(--space-6);
  }

  .container-demo {
    width: 100%;
    padding: var(--space-3);
    border-inline-start: var(--border-accent) solid var(--color-brand-cyan);
    background: var(--color-surface-subtle);
  }

  .container-demo--readable {
    max-width: var(--container-readable);
  }

  .container-demo--standard {
    max-width: var(--container-standard);
  }

  .container-demo--wide {
    max-width: var(--container-wide);
  }

  .grid-demo span {
    display: grid;
    min-height: 3rem;
    place-items: center;
    border: var(--border-hairline) solid var(--color-border-subtle);
    color: var(--color-text-secondary);
  }

  .grid-demo span:nth-child(n + 5) {
    display: none;
  }

  .spacing-demo {
    display: grid;
    gap: var(--space-3);
  }

  .spacing-demo > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    align-items: center;
  }

  .space-bar {
    display: block;
    width: var(--space-size);
    min-width: 0.25rem;
    height: 0.75rem;
    background: var(--color-brand-cyan-active);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-6);
  }

  .stats div {
    padding-block: var(--space-4);
    border-block-start: var(--border-hairline) solid var(--color-border-on-dark);
  }

  .stats dt {
    font-family: var(--font-family-display);
    font-size: var(--font-size-stat-m);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 0.95;
  }

  .stats dt span {
    font-family: var(--font-family-ui);
    font-size: 0.4em;
    font-weight: 600;
  }

  .stats dd {
    margin-block-start: var(--space-2);
    color: var(--color-text-inverted-secondary);
    font-size: var(--font-size-body-s);
  }

  .technical-rows {
    border-block-start: var(--border-hairline) solid var(--color-border-on-dark);
  }

  .technical-rows div {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-end: var(--border-hairline) solid var(--color-border-on-dark);
  }

  .technical-rows dt {
    font-weight: 600;
  }

  .technical-rows dd {
    color: var(--color-text-inverted-secondary);
  }

  @media (min-width: 48rem) {
    .grid-demo span:nth-child(n + 5) {
      display: grid;
    }

    .grid-demo span:nth-child(n + 9) {
      display: none;
    }

    .technical-rows div {
      grid-template-columns: minmax(12rem, 1fr) 2fr;
    }
  }

  @media (min-width: 64rem) {
    .grid-demo span:nth-child(n + 9) {
      display: grid;
    }
  }
</style>
