---
import { getCollection } from "astro:content";

import LeadForm from "@/components/lead/LeadForm.astro";
import SiteHeader from "@/components/navigation/SiteHeader.astro";
import Container from "@/components/primitives/Container.astro";
import Section from "@/components/primitives/Section.astro";
import Stack from "@/components/primitives/Stack.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const products = await getCollection("products");
---

<BaseLayout
  title="Solicitud de test ride — CFMOTO Uruguay"
  description="Demostración frontend de solicitud de test ride CFMOTO Uruguay."
  robots="noindex, nofollow"
>
  <SiteHeader slot="header" />
  <Section
    density="functional"
    surface="light"
    aria-labelledby="test-ride-title"
  >
    <Container size="readable">
      <Stack gap="8">
        <div class="form-heading">
          <p class="type-label">COORDINACIÓN COMERCIAL</p>
          <h1 id="test-ride-title" class="type-display-l">
            Solicitud de test ride
          </h1>
          <p class="type-body-l">
            Esta demostración no reserva fecha, ubicación ni unidad. La
            disponibilidad deberá confirmarse mediante el futuro proceso
            comercial.
          </p>
        </div>
        <LeadForm kind="testRide" products={products} />
      </Stack>
    </Container>
  </Section>
</BaseLayout>

<style>
  .form-heading {
    display: grid;
    gap: var(--space-3);
  }
  .form-heading .type-label {
    color: var(--color-link-on-light);
  }
  .form-heading p:last-child {
    color: var(--color-text-secondary);
  }
</style>
