---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: "div" | "nav" | "ul";
  gap?: "2" | "3" | "6";
}

const {
  as: Tag = "div",
  gap = "3",
  class: className,
  ...attributes
} = Astro.props;
---

<Tag class:list={["cluster", `cluster--${gap}`, className]} {...attributes}>
  <slot />
</Tag>
